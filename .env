# ── Backend URL ──────────────────────────────────────────────
# Point this to wherever your PHP files are served from.
# XAMPP example:
VITE_API_BASE=http://localhost/companion/backend

# PHP built-in server (run: php -S localhost:8000 -t backend):
# VITE_API_BASE=http://localhost:8000

# ── Razorpay (set in backend/payment.php, NOT here) ─────────
# Get free test keys at https://dashboard.razorpay.com
# Replace the placeholder values in backend/payment.php:
#   RAZORPAY_KEY_ID     = rzp_test_xxxxxxxxxxxx
#   RAZORPAY_KEY_SECRET = your_secret_here
